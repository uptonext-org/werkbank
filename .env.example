# Copy this file to .env and adjust as needed. Never commit a real .env.

# --- Database ---
# Used by docker-compose.yml to configure the postgres container.
POSTGRES_USER=werkbank
POSTGRES_PASSWORD=werkbank
POSTGRES_DB=werkbank
POSTGRES_PORT=5432
# Host apps/api connects to: "localhost" when apps/api runs on your
# machine (outside Docker), "db" when apps/api itself runs inside
# docker-compose (docker-compose.yml defaults to "db" for the api
# service regardless of this value, since it must always reach
# PostgreSQL by its compose service name).
POSTGRES_HOST=localhost

# Used by apps/api to connect to PostgreSQL when run outside Docker. Match
# the values above. Ignored by docker-compose.yml, which builds this same
# URL itself from the POSTGRES_* variables so the api container always
# reaches the db container by its service name.
DATABASE_URL=postgresql+psycopg://werkbank:werkbank@localhost:5432/werkbank

# --- API ---
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
API_PORT=8000

# --- Auth (placeholders; wired up once app/shared/auth is implemented) ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Web (apps/web) ---
# Published port for the web container (docker-compose.yml).
WEB_PORT=5173
# Where the built web app sends API requests. Baked into the production
# build at image-build time (Vite inlines VITE_* variables at build, not
# at container runtime — see infra/docker/web.Dockerfile), so changing
# this requires a rebuild, not just a restart. Defaults to a same-origin
# "/api" path that nginx reverse-proxies to the api service (see
# infra/docker/nginx.web.conf); override only if serving web and api from
# different origins.
VITE_API_URL=/api
